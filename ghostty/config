# ============================================
# ~/.config/ghostty/config  (cmux + Ghostty)
# ============================================

# --- Window ---
background-opacity = 0.8
background-blur = 20
window-width = 180
window-height = 50

# --- Font ---
font-family = JetBrainsMono Nerd Font
font-family = PlemolJP Console NF
font-family = Noto Color Emoji
font-size = 12

# --- Cursor ---
cursor-style = block
cursor-style-blink = false

# --- Theme ---
