# ============================================
# ~/.config/ghostty/config  (cmux + Ghostty)
# ============================================

# --- Window ---
background-opacity = 0.85
background-blur = 20
window-width = 180
window-height = 50

# --- Font ---
font-family = JetBrainsMono Nerd Font
font-family = PlemolJP Console NF
font-family = Noto Color Emoji
font-size = 12

# --- Cursor ---
# wezterm の SteadyBlock 相当（ブロック形状・点滅なし）
cursor-style = block
cursor-style-blink = false
